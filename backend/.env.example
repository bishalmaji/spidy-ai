# Server
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Groq Cloud (free tier) - https://console.groq.com/keys
# Used for: Whisper speech-to-text + the Spidy chat LLM.
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Neon Postgres
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# Note on architecture:
# This build uses tap-to-talk (not OpenAI's Realtime WebRTC API), because this
# project only has Groq's free tier configured. There is no OpenAI key here,
# so no server-side VAD / true audio barge-in is implemented. See README.md.
